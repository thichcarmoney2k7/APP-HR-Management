<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="700.0" prefWidth="1160.0"
      styleClass="login-root" stylesheets="@login.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.AuthController">

    <!-- Cột trái: Giới thiệu thương hiệu & hình ảnh từ mạng -->
    <StackPane prefWidth="520.0" styleClass="brand-panel">
        <ImageView fitHeight="700.0" fitWidth="520.0" opacity="0.24" preserveRatio="false">
            <image>
                <Image url="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&amp;fit=crop&amp;w=1000&amp;q=80"
                       backgroundLoading="true"/>
            </image>
        </ImageView>

        <VBox alignment="CENTER_LEFT" spacing="18.0" maxWidth="420.0">
            <padding>
                <Insets bottom="36.0" left="40.0" right="40.0" top="36.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <ImageView fitHeight="46.0" fitWidth="46.0" preserveRatio="true">
                    <image>
                        <Image url="https://cdn-icons-png.flaticon.com/512/4712/4712109.png"
                               backgroundLoading="true"/>
                    </image>
                </ImageView>
                <VBox>
                    <Label text="AI HRM SYSTEM" styleClass="hero-brand"/>
                    <Label text="Quản trị Nhân sự &amp; Tuyển dụng thông minh" styleClass="hero-subbrand"/>
                </VBox>
            </HBox>

            <Label text="Nền tảng nhân sự tích hợp trí tuệ nhân tạo Gemini"
                   styleClass="hero-headline" wrapText="true"/>

            <Label text="Sàng lọc CV và phỏng vấn tự động cho ứng viên, theo dõi công việc &amp; KPI cho nhân viên, và điều hành toàn bộ quy trình nhân sự tập trung."
                   styleClass="hero-desc" wrapText="true"/>

            <VBox spacing="10.0" styleClass="feature-box">
                <Label text="✦  Sàng lọc CV &amp; bộ câu hỏi phỏng vấn AI tự động" styleClass="feature-item"/>
                <Label text="✦  Xác thực khuôn mặt &amp; quản lý hiệu suất minh bạch" styleClass="feature-item"/>
                <Label text="✦  Phân quyền rõ ràng: Ứng viên • Nhân viên • Quản lý" styleClass="feature-item"/>
            </VBox>

            <!-- Các tag màu nổi bật -->
            <HBox spacing="8.0">
                <Label text="Ứng viên"
                       style="-fx-background-color: rgba(168, 85, 247, 0.35); -fx-text-fill: #f3e8ff; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-padding: 5 12; -fx-background-radius: 999; -fx-border-color: rgba(216, 180, 254, 0.5); -fx-border-radius: 999;"/>
                <Label text="Nhân viên"
                       style="-fx-background-color: rgba(20, 184, 166, 0.35); -fx-text-fill: #ccfbf1; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-padding: 5 12; -fx-background-radius: 999; -fx-border-color: rgba(94, 234, 212, 0.5); -fx-border-radius: 999;"/>
                <Label text="Quản lý"
                       style="-fx-background-color: rgba(56, 189, 248, 0.35); -fx-text-fill: #e0f2fe; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-padding: 5 12; -fx-background-radius: 999; -fx-border-color: rgba(125, 211, 252, 0.5); -fx-border-radius: 999;"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Cột phải: Form Đăng nhập -->
    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="form-side">
        <padding>
            <Insets bottom="32.0" left="48.0" right="48.0" top="32.0"/>
        </padding>

        <VBox spacing="16.0" maxWidth="420.0" styleClass="login-card">
            <!-- Dải màu gradient nổi bật ở đầu card -->
            <Region prefHeight="6.0" maxWidth="Infinity"
                    style="-fx-background-color: linear-gradient(to right, #2563eb, #8b5cf6, #06b6d4); -fx-background-radius: 999;"/>

            <VBox spacing="4.0">
                <Label text="Đăng nhập hệ thống" styleClass="form-title"/>
                <Label text="Nhập tài khoản của bạn để truy cập không gian làm việc." styleClass="form-subtitle"/>
            </VBox>

            <Separator style="-fx-opacity: 0.5;"/>

            <VBox spacing="6.0">
                <Label text="Tên đăng nhập / Email" styleClass="field-label"/>
                <TextField fx:id="txtLoginUsername" promptText="Ví dụ: candidate@gmail.com hoặc admin@hrm.com"
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Mật khẩu" styleClass="field-label"/>
                <PasswordField fx:id="txtLoginPassword" promptText="Nhập mật khẩu của bạn"
                               styleClass="input-field"/>
            </VBox>

            <Label fx:id="lblStatus" text="" styleClass="status-label" wrapText="true"/>

            <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogin"
                    styleClass="primary-btn" text="Đăng nhập"/>

            <HBox alignment="CENTER" spacing="6.0">
                <padding>
                    <Insets top="4.0"/>
                </padding>
                <Label text="Ứng viên mới chưa có tài khoản?" styleClass="hint-text"/>
                <Label text="Đăng ký ứng viên" styleClass="link-accent"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
        <Label text="AI HRM Platform • JavaFX &amp; Spring Boot" styleClass="footer-note"/>
    </VBox>
</HBox>