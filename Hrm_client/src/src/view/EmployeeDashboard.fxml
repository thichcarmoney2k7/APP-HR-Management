<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainBorderPane" prefHeight="740.0" prefWidth="1220.0"
            styleClass="root-bg" stylesheets="@dashboard.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.EmployeeDashboardController">

    <left>
        <VBox prefWidth="260.0" spacing="10.0" styleClass="sidebar-employee">
            <padding>
                <Insets bottom="20.0" left="14.0" right="14.0" top="22.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                    <image>
                        <Image url="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" backgroundLoading="true"/>
                    </image>
                </ImageView>
                <VBox>
                    <Label text="AI HRM" styleClass="brand-title"/>
                    <Label text="Không gian Nhân viên" style="-fx-text-fill: #99f6e4; -fx-font-size: 11.5px;"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="user-card">
                <ImageView fitHeight="42.0" fitWidth="42.0" preserveRatio="true">
                    <image>
                        <Image url="https://ui-avatars.com/api/?name=Employee&amp;background=0d9488&amp;color=fff&amp;rounded=true" backgroundLoading="true"/>
                    </image>
                </ImageView>
                <VBox spacing="2.0">
                    <Label fx:id="lblWelcome" text="Nhân viên" styleClass="user-name" wrapText="true"/>
                    <Label text="Face ID • Task • KPI" styleClass="user-role"/>
                </VBox>
            </HBox>

            <Separator style="-fx-opacity: 0.25;">
                <VBox.margin>
                    <Insets bottom="4.0" top="4.0"/>
                </VBox.margin>
            </Separator>

            <Button fx:id="btnNavAttendance" maxWidth="Infinity" onAction="#showAttendance"
                    styleClass="nav-btn" text="📷  Chấm công Khuôn mặt"/>
            <Button fx:id="btnNavTasks" maxWidth="Infinity" onAction="#showTasks"
                    styleClass="nav-btn" text="✅  Công việc của tôi"/>
            <Button fx:id="btnNavKPI" maxWidth="Infinity" onAction="#showKPI"
                    styleClass="nav-btn" text="🏆  KPI cá nhân"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="logout-btn" text="🚪  Đăng xuất"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="16.0" maxWidth="Infinity" maxHeight="Infinity">
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="topbar">
                <Button fx:id="btnBack" onAction="#handleBack" styleClass="nav-arrow-btn" text="◀ Lùi"/>
                <Button fx:id="btnForward" onAction="#handleForward" styleClass="nav-arrow-btn" text="Tiến ▶"/>
                <Label fx:id="lblCurrentPage" text="Chấm công Khuôn mặt" styleClass="page-title">
                    <HBox.margin>
                        <Insets left="8.0"/>
                    </HBox.margin>
                </Label>
            </HBox>

            <VBox alignment="TOP_LEFT" spacing="18.0" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="20.0" left="22.0" right="22.0" top="4.0"/>
                </padding>

                <!-- Banner nằm gọn ở phía trên -->
                <HBox alignment="CENTER_LEFT" spacing="20.0" maxWidth="Infinity" styleClass="welcome-banner">
                    <ImageView fitHeight="105.0" fitWidth="155.0" preserveRatio="true">
                        <image>
                            <Image url="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&amp;fit=crop&amp;w=500&amp;q=80" backgroundLoading="true"/>
                        </image>
                    </ImageView>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Chào mừng trở lại làm việc"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        <Label text="Đăng ký Face ID, check-in/check-out hằng ngày, cập nhật tiến độ công việc và xem chỉ số KPI cá nhân."
                               style="-fx-text-fill: #64748b; -fx-font-size: 13px;" wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- 3 thẻ chức năng nổi bật bên dưới -->
                <HBox spacing="16.0" maxWidth="Infinity">
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="quick-card">
                        <ImageView fitHeight="115.0" fitWidth="260.0" preserveRatio="true">
                            <image>
                                <Image url="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&amp;fit=crop&amp;w=500&amp;q=80" backgroundLoading="true"/>
                            </image>
                        </ImageView>
                        <Label text="Chấm công Khuôn mặt" styleClass="quick-card-title"/>
                        <Label text="Chụp ảnh webcam để xác thực Face ID, ghi nhận giờ vào/ra và xem lịch sử công."
                               styleClass="quick-card-desc" wrapText="true"/>
                    </VBox>

                    <VBox spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="quick-card">
                        <ImageView fitHeight="115.0" fitWidth="260.0" preserveRatio="true">
                            <image>
                                <Image url="https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?auto=format&amp;fit=crop&amp;w=500&amp;q=80" backgroundLoading="true"/>
                            </image>
                        </ImageView>
                        <Label text="Công việc của tôi" styleClass="quick-card-title"/>
                        <Label text="Xem danh sách đầu việc được giao, deadline và cập nhật trạng thái hoàn thành."
                               styleClass="quick-card-desc" wrapText="true"/>
                    </VBox>

                    <VBox spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="quick-card">
                        <ImageView fitHeight="115.0" fitWidth="260.0" preserveRatio="true">
                            <image>
                                <Image url="https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&amp;fit=crop&amp;w=500&amp;q=80" backgroundLoading="true"/>
                            </image>
                        </ImageView>
                        <Label text="KPI cá nhân" styleClass="quick-card-title"/>
                        <Label text="Theo dõi điểm đánh giá hiệu suất, phản hồi từ quản lý và mục tiêu kỳ này."
                               styleClass="quick-card-desc" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>