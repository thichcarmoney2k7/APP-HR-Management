<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="emp-root" stylesheets="@employee.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.UserKPIController">

    <VBox spacing="16.0" maxWidth="Infinity">
        <padding>
            <Insets bottom="24.0" left="22.0" right="22.0" top="10.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16.0" maxWidth="Infinity" styleClass="emp-hero">
            <ImageView fitHeight="74.0" fitWidth="110.0" preserveRatio="true">
                <image>
                    <Image url="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&amp;fit=crop&amp;w=500&amp;q=80"
                           backgroundLoading="true"/>
                </image>
            </ImageView>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="✦ KPI CÁ NHÂN &amp; NHẬN XÉT AI"
                       style="-fx-text-fill: #fde047; -fx-font-size: 11.5px; -fx-font-weight: bold;"/>
                <Label text="Tra cứu hiệu suất tháng, tiền thưởng &amp; lịch sử KPI"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold;" wrapText="true"/>
                <Label text="Chọn tháng (yyyy-MM) hoặc bấm vào một dòng trong bảng lịch sử để xem chi tiết KPI và nhận xét từ Gemini AI."
                       style="-fx-text-fill: #f0fdfa; -fx-font-size: 12.5px;" wrapText="true"/>
            </VBox>
        </HBox>

        <!-- Thanh chọn tháng -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="emp-card-teal">
            <Label text="Tháng (yyyy-MM):" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtMonthYear" prefWidth="135.0" promptText="2026-11" styleClass="emp-input"/>
            <Button onAction="#loadMonthlyKPI" styleClass="emp-btn-teal" text="Tra cứu KPI tháng"/>
            <Button onAction="#loadKPIHistory" styleClass="emp-nav-btn" text="Tải lại lịch sử"/>
        </HBox>

        <Label fx:id="lblStatusMessage" text="" style="-fx-font-weight: bold; -fx-font-size: 13px;" wrapText="true"/>

        <!-- Chi tiết KPI tháng + Bảng lịch sử -->
        <HBox spacing="16.0" maxWidth="Infinity">
            <VBox spacing="10.0" prefWidth="420.0" styleClass="emp-card-purple">
                <Label text="Chi tiết KPI theo tháng" styleClass="emp-card-title" style="-fx-text-fill: #7e22ce;"/>
                <Label fx:id="lblCompletionRate" text="Tỷ lệ hoàn thành KPI: --"
                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0284c7;"/>
                <Label fx:id="lblTaskSummary" text="Công việc hoàn thành: --"
                       style="-fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label fx:id="lblAttendanceSummary" text="Ngày đi làm: --"
                       style="-fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label fx:id="lblBonusAmount" text="Thưởng KPI: --"
                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0d9488;"/>

                <Label text="Nhận xét từ AI:" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="txtAiFeedback" editable="false" prefHeight="165.0" wrapText="true"
                          styleClass="emp-input" promptText="Nhận xét KPI từ AI sẽ hiển thị tại đây..."/>
            </VBox>

            <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="emp-card-blue">
                <Label text="Lịch sử KPI qua các tháng" styleClass="emp-card-title"/>
                <TableView fx:id="tblKpiHistory" prefHeight="330.0" maxWidth="Infinity">
                    <columns>
                        <TableColumn fx:id="colMonthYear" prefWidth="110.0" text="Tháng"/>
                        <TableColumn fx:id="colCompletionRate" prefWidth="125.0" text="Tỷ lệ (%)"/>
                        <TableColumn fx:id="colBonusAmount" prefWidth="145.0" text="Thưởng KPI"/>
                        <TableColumn fx:id="colFeedback" prefWidth="280.0" text="Nhận xét AI"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>