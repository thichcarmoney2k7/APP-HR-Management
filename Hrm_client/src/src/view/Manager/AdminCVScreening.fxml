<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="root-bg" stylesheets="@../dashboard.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.AdminCVScreeningController">

    <VBox spacing="16.0" maxWidth="Infinity">
        <padding>
            <Insets bottom="22.0" left="22.0" right="22.0" top="10.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" maxWidth="Infinity" styleClass="welcome-banner">
            <ImageView fitHeight="72.0" fitWidth="105.0" preserveRatio="true">
                <image>
                    <Image url="https://images.unsplash.com/photo-1586281380349-632531db7ed4?auto=format&amp;fit=crop&amp;w=400&amp;q=80"
                           backgroundLoading="true"/>
                </image>
            </ImageView>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="Sàng lọc CV, Đánh giá AI &amp; Tuyển dụng"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label text="Lọc hồ sơ ứng viên, xem nhận xét từ AI, duyệt/từ chối hoặc chuyển ứng viên APPROVED thành nhân viên."
                       style="-fx-text-fill: #64748b; -fx-font-size: 12.5px;" wrapText="true"/>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <ComboBox fx:id="cboStatusFilter" prefWidth="140.0"/>
                <Button onAction="#loadCandidates" text="Tải lại" styleClass="nav-arrow-btn"/>
            </HBox>
        </HBox>

        <Label fx:id="lblStatusMessage" text="" style="-fx-font-weight: bold; -fx-font-size: 12.5px;" wrapText="true"/>

        <!-- Bảng ứng viên -->
        <VBox spacing="8.0" styleClass="quick-card" style="-fx-cursor: default;">
            <Label text="Danh sách ứng viên" styleClass="quick-card-title"/>
            <TableView fx:id="tblCandidates" prefHeight="230.0" maxWidth="Infinity">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="65.0" text="ID"/>
                    <TableColumn fx:id="colFullName" prefWidth="170.0" text="Họ tên"/>
                    <TableColumn fx:id="colEmail" prefWidth="195.0" text="Email"/>
                    <TableColumn fx:id="colPosition" prefWidth="160.0" text="Vị trí ứng tuyển"/>
                    <TableColumn fx:id="colExperience" prefWidth="105.0" text="Kinh nghiệm"/>
                    <TableColumn fx:id="colAiScore" prefWidth="95.0" text="Điểm AI"/>
                    <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng thái"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Nhận xét AI & Tuyển dụng -->
        <HBox spacing="16.0" maxWidth="Infinity">
            <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="quick-card" style="-fx-cursor: default;">
                <Label text="Chi tiết đánh giá CV &amp; Phỏng vấn từ AI" styleClass="quick-card-title"/>
                <TextArea fx:id="txtAiFeedbackDetail" editable="false" prefHeight="140.0" wrapText="true"
                          promptText="Chọn một ứng viên trên bảng để xem nhận xét chi tiết..."/>
                <HBox spacing="10.0">
                    <Button fx:id="btnApprove" onAction="#handleApproveCandidate" text="Duyệt ứng viên"
                            style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
                    <Button fx:id="btnReject" onAction="#handleRejectCandidate" text="Từ chối"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <VBox spacing="10.0" prefWidth="340.0" styleClass="quick-card" style="-fx-cursor: default;">
                <Label text="Tuyển dụng thành Nhân viên" styleClass="quick-card-title"/>
                <Label text="Chỉ áp dụng cho ứng viên đang ở trạng thái APPROVED." styleClass="quick-card-desc" wrapText="true"/>
                <TextField fx:id="txtOfferSalary" promptText="Lương đề xuất (VD: 15000000)"/>
                <TextField fx:id="txtDepartmentId" promptText="Mã phòng ban (VD: 1)"/>
                <Button fx:id="btnHireCandidate" maxWidth="Infinity" onAction="#handleHireCandidate"
                        text="Xác nhận Tuyển dụng"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>