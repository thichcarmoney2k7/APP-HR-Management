<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.Region?>
<ScrollPane fitToWidth="true" styleClass="emp-root" stylesheets="@employee.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.UserAttendanceController">

    <VBox spacing="16.0" maxWidth="Infinity">
        <padding>
            <Insets bottom="24.0" left="22.0" right="22.0" top="10.0"/>
        </padding>

        <!-- Header rực rỡ -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" maxWidth="Infinity" styleClass="emp-hero">
            <ImageView fitHeight="76.0" fitWidth="112.0" preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 10, 0, 0, 3);">
                <image>
                    <Image url="https://images.unsplash.com/photo-1506784983877-45594efa4cbe?auto=format&amp;fit=crop&amp;w=500&amp;q=80"
                           backgroundLoading="true"/>
                </image>
            </ImageView>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="✦ CHẤM CÔNG &amp; LỊCH SỬ ĐIỂM DANH"
                       style="-fx-text-fill: #fde047; -fx-font-size: 11.5px; -fx-font-weight: bold;"/>
                <Label text="Theo dõi ca làm việc hôm nay &amp; bảng công cá nhân"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold;" wrapText="true"/>
                <Label text="Quét khuôn mặt được thực hiện trên máy Quản lý; tại đây bạn xem trạng thái hôm nay và tra cứu lịch sử chấm công."
                       style="-fx-text-fill: #f0fdfa; -fx-font-size: 12.5px;" wrapText="true"/>
            </VBox>
        </HBox>

        <Label fx:id="lblMessage" text="" style="-fx-font-weight: bold; -fx-font-size: 13px;" wrapText="true"/>

        <!-- Thẻ trạng thái ca làm việc hôm nay -->
        <VBox spacing="10.0" styleClass="emp-card-teal">
            <Region prefHeight="4.0" maxWidth="Infinity"
                    style="-fx-background-color: linear-gradient(to right, #0d9488, #06b6d4); -fx-background-radius: 999;"/>
            <HBox alignment="CENTER_LEFT" spacing="18.0">
                <Label fx:id="lblEmployeeName" text="Nhân viên: --"
                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;"/>
                <Label fx:id="lblTodayDate" text="Ngày: --"
                       style="-fx-font-weight: bold; -fx-font-size: 13.5px; -fx-text-fill: #0284c7;"/>
            </HBox>
            <HBox spacing="24.0">
                <Label fx:id="lblCheckInTime" text="Giờ vào: --"
                       style="-fx-font-weight: bold; -fx-text-fill: #0f766e;"/>
                <Label fx:id="lblCheckOutTime" text="Giờ ra: --"
                       style="-fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
                <Label fx:id="lblTodayStatus" text="Trạng thái: --"
                       style="-fx-font-weight: bold; -fx-text-fill: #7e22ce;"/>
            </HBox>
        </VBox>

        <!-- Bảng lịch sử chấm công -->
        <VBox spacing="10.0" styleClass="emp-card-blue">
            <Region prefHeight="4.0" maxWidth="Infinity"
                    style="-fx-background-color: linear-gradient(to right, #2563eb, #7c3aed); -fx-background-radius: 999;"/>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Lịch sử chấm công" styleClass="emp-card-title" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtMonthFilter" prefWidth="135.0" promptText="yyyy-MM" styleClass="emp-input"/>
                <Button onAction="#handleFilterByMonth" styleClass="emp-btn-teal" text="Lọc tháng"/>
                <Button onAction="#loadFullHistory" styleClass="emp-nav-btn" text="Tất cả"/>
            </HBox>

            <TableView fx:id="tblAttendance" prefHeight="290.0" maxWidth="Infinity">
                <columns>
                    <TableColumn fx:id="colWorkDate" prefWidth="130.0" text="Ngày làm"/>
                    <TableColumn fx:id="colCheckIn" prefWidth="125.0" text="Giờ vào"/>
                    <TableColumn fx:id="colCheckOut" prefWidth="125.0" text="Giờ ra"/>
                    <TableColumn fx:id="colLateMinutes" prefWidth="120.0" text="Đi muộn (p)"/>
                    <TableColumn fx:id="colWorkHours" prefWidth="120.0" text="Số giờ làm"/>
                    <TableColumn fx:id="colStatus" prefWidth="150.0" text="Trạng thái"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>