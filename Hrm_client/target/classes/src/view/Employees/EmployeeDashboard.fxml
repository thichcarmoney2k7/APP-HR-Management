<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainBorderPane" prefHeight="780.0" prefWidth="1320.0"
            styleClass="emp-root" stylesheets="@employee.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.EmployeeDashboardController">

    <left>
        <VBox prefWidth="270.0" spacing="10.0" styleClass="emp-sidebar">
            <padding>
                <Insets bottom="20.0" left="14.0" right="14.0" top="22.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ImageView fitHeight="38.0" fitWidth="38.0" preserveRatio="true">
                    <image>
                        <Image url="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" backgroundLoading="true"/>
                    </image>
                </ImageView>
                <VBox>
                    <Label text="AI HRM WORKSPACE" styleClass="emp-brand-title"/>
                    <Label text="Không gian Nhân viên" styleClass="emp-brand-sub"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="emp-user-card">
                <ImageView fitHeight="44.0" fitWidth="44.0" preserveRatio="true">
                    <image>
                        <Image url="https://ui-avatars.com/api/?name=Employee&amp;background=0d9488&amp;color=fff&amp;rounded=true"
                               backgroundLoading="true"/>
                    </image>
                </ImageView>
                <VBox spacing="2.0">
                    <Label fx:id="lblWelcome" text="Nhân viên" styleClass="emp-user-name" wrapText="true"/>
                    <Label text="✦ Chấm công • Task • KPI" styleClass="emp-user-role"/>
                </VBox>
            </HBox>

            <Separator style="-fx-opacity: 0.25;">
                <VBox.margin>
                    <Insets bottom="4.0" top="4.0"/>
                </VBox.margin>
            </Separator>

            <Button fx:id="btnNavOverview" maxWidth="Infinity" onAction="#showOverview"
                    text="🏠  Tổng quan Cá nhân"/>
            <Button fx:id="btnNavAttendance" maxWidth="Infinity" onAction="#showAttendance"
                    text="🕒  Lịch sử Chấm công"/>
            <Button fx:id="btnNavTasks" maxWidth="Infinity" onAction="#showTasks"
                    text="📋  Công việc của tôi"/>
            <Button fx:id="btnNavKPI" maxWidth="Infinity" onAction="#showKPI"
                    text="📊  KPI &amp; Thưởng cá nhân"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="emp-logout-btn" text="🚪  Đăng xuất"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12.0" maxWidth="Infinity" maxHeight="Infinity">
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="emp-topbar">
                <Button fx:id="btnBack" onAction="#handleBack" styleClass="emp-nav-btn" text="◀ Lùi"/>
                <Button fx:id="btnForward" onAction="#handleForward" styleClass="emp-nav-btn" text="Tiến ▶"/>
                <Label fx:id="lblCurrentPage" text="Không gian Nhân viên AI HRM" styleClass="emp-page-title">
                    <HBox.margin>
                        <Insets left="8.0"/>
                    </HBox.margin>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="✦ Employee Portal • Gemini AI"
                       style="-fx-background-color: linear-gradient(to right, #0d9488, #0284c7); -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 11.5px; -fx-padding: 6 14; -fx-background-radius: 999;"/>
            </HBox>

            <VBox fx:id="contentContainer" alignment="TOP_LEFT" spacing="18.0" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <StackPane maxWidth="Infinity">
                        <ImageView fitHeight="680.0" fitWidth="1040.0" opacity="0.06" preserveRatio="false">
                            <image>
                                <Image url="https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&amp;fit=crop&amp;w=1200&amp;q=80"
                                       backgroundLoading="true"/>
                            </image>
                        </ImageView>

                        <VBox fx:id="overviewView" alignment="TOP_LEFT" spacing="18.0" maxWidth="Infinity">
                            <padding>
                                <Insets bottom="24.0" left="22.0" right="22.0" top="6.0"/>
                            </padding>

                            <!-- Banner rực rỡ ở trên -->
                            <HBox alignment="CENTER_LEFT" spacing="22.0" maxWidth="Infinity" styleClass="emp-hero">
                                <ImageView fitHeight="120.0" fitWidth="180.0" preserveRatio="true"
                                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 12, 0, 0, 4);">
                                    <image>
                                        <Image url="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                               backgroundLoading="true"/>
                                    </image>
                                </ImageView>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="✦ KHÔNG GIAN LÀM VIỆC NHÂN VIÊN AI HRM"
                                           style="-fx-text-fill: #fde047; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                    <Label text="Theo dõi chấm công, cập nhật tiến độ task &amp; xem đánh giá KPI"
                                           style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: bold;" wrapText="true"/>
                                    <Label text="Xem ca làm việc hôm nay và lịch sử chấm công, xử lý công việc được giao và tra cứu KPI + nhận xét AI theo từng tháng."
                                           style="-fx-text-fill: #f0fdfa; -fx-font-size: 13px;" wrapText="true"/>
                                </VBox>
                            </HBox>

                            <!-- 3 thẻ chức năng rực rỡ ở dưới -->
                            <HBox spacing="16.0" maxWidth="Infinity">
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="emp-card-teal">
                                    <Region prefHeight="5.0" maxWidth="Infinity"
                                            style="-fx-background-color: linear-gradient(to right, #0d9488, #06b6d4); -fx-background-radius: 999;"/>
                                    <ImageView fitHeight="125.0" fitWidth="290.0" preserveRatio="true">
                                        <image>
                                            <Image url="https://images.unsplash.com/photo-1506784983877-45594efa4cbe?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                                   backgroundLoading="true"/>
                                        </image>
                                    </ImageView>
                                    <Label text="🕒 Lịch sử Chấm công" styleClass="emp-card-title"
                                           style="-fx-text-fill: #0f766e;"/>
                                    <Label text="Xem giờ vào, giờ ra, số phút đi muộn hôm nay và tra cứu bảng công theo tháng."
                                           styleClass="emp-card-desc" wrapText="true"/>
                                    <Button maxWidth="Infinity" onAction="#showAttendance" styleClass="emp-btn-teal"
                                            text="Xem Chấm công →"/>
                                </VBox>

                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="emp-card-blue">
                                    <Region prefHeight="5.0" maxWidth="Infinity"
                                            style="-fx-background-color: linear-gradient(to right, #2563eb, #7c3aed); -fx-background-radius: 999;"/>
                                    <ImageView fitHeight="125.0" fitWidth="290.0" preserveRatio="true">
                                        <image>
                                            <Image url="https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                                   backgroundLoading="true"/>
                                        </image>
                                    </ImageView>
                                    <Label text="📋 Công việc của tôi" styleClass="emp-card-title"
                                           style="-fx-text-fill: #1d4ed8;"/>
                                    <Label text="Lọc công việc theo trạng thái hoặc tháng, xem mô tả chi tiết và báo cáo hoàn thành."
                                           styleClass="emp-card-desc" wrapText="true"/>
                                    <Button maxWidth="Infinity" onAction="#showTasks" styleClass="emp-btn-teal"
                                            text="Mở Công việc →"/>
                                </VBox>

                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="emp-card-purple">
                                    <Region prefHeight="5.0" maxWidth="Infinity"
                                            style="-fx-background-color: linear-gradient(to right, #8b5cf6, #ec4899); -fx-background-radius: 999;"/>
                                    <ImageView fitHeight="125.0" fitWidth="290.0" preserveRatio="true">
                                        <image>
                                            <Image url="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                                                   backgroundLoading="true"/>
                                        </image>
                                    </ImageView>
                                    <Label text="📊 KPI &amp; Thưởng cá nhân" styleClass="emp-card-title"
                                           style="-fx-text-fill: #7e22ce;"/>
                                    <Label text="Tra cứu tỷ lệ hoàn thành KPI, tiền thưởng đề xuất, nhận xét AI và lịch sử qua các tháng."
                                           styleClass="emp-card-desc" wrapText="true"/>
                                    <Button maxWidth="Infinity" onAction="#showKPI" styleClass="emp-btn-purple"
                                            text="Xem KPI cá nhân →"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </StackPane>
                </ScrollPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>