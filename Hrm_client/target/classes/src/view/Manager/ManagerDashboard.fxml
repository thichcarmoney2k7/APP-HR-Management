<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainBorderPane" prefHeight="800.0" prefWidth="1360.0"
            styleClass="mgr-dash-root" stylesheets="@manager.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.ManagerDashboardController">

    <!-- Sidebar trái -->
    <left>
        <VBox prefWidth="275.0" spacing="9.0" styleClass="mgr-dash-sidebar">
            <padding>
                <Insets bottom="20.0" left="14.0" right="14.0" top="22.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ImageView fitHeight="38.0" fitWidth="38.0" preserveRatio="true">
                    <image>
                        <Image backgroundLoading="true" url="https://cdn-icons-png.flaticon.com/512/1995/1995574.png"/>
                    </image>
                </ImageView>
                <VBox>
                    <Label text="AI HRM COMMAND" styleClass="mgr-dash-brand"/>
                    <Label text="Quản trị &amp; Điều hành tập trung" styleClass="mgr-dash-brand-sub"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="mgr-dash-user-card">
                <ImageView fitHeight="44.0" fitWidth="44.0" preserveRatio="true">
                    <image>
                        <Image backgroundLoading="true"
                               url="https://ui-avatars.com/api/?name=Manager&amp;background=7c3aed&amp;color=fff&amp;rounded=true"/>
                    </image>
                </ImageView>
                <VBox spacing="2.0">
                    <Label fx:id="lblWelcome" text="Quản lý" styleClass="mgr-dash-user-name" wrapText="true"/>
                    <Label fx:id="lblRoleBadge" text="Vai trò: MANAGER" styleClass="mgr-dash-user-role"/>
                </VBox>
            </HBox>

            <Separator style="-fx-opacity: 0.25;">
                <VBox.margin>
                    <Insets bottom="4.0" top="4.0"/>
                </VBox.margin>
            </Separator>

            <Button fx:id="btnNavOverview" maxWidth="Infinity" onAction="#showOverview"
                    styleClass="mgr-dash-nav-btn" text="🧭  Tổng quan Điều hành"/>
            <Button fx:id="btnNavAttendance" maxWidth="Infinity" onAction="#showAttendance"
                    styleClass="mgr-dash-nav-btn" text="📷  Chấm công Face ID"/>
            <Button fx:id="btnNavCV" maxWidth="Infinity" onAction="#showCVScreening"
                    styleClass="mgr-dash-nav-btn" text="📄  Sàng lọc CV &amp; Tuyển dụng"/>
            <Button fx:id="btnNavEmployee" maxWidth="Infinity" onAction="#showEmployeeMgmt"
                    styleClass="mgr-dash-nav-btn" text="👥  Quản lý Nhân sự"/>
            <Button fx:id="btnNavTask" maxWidth="Infinity" onAction="#showTaskMgmt"
                    styleClass="mgr-dash-nav-btn" text="📋  Quản lý Công việc"/>
            <Button fx:id="btnNavKPI" maxWidth="Infinity" onAction="#showKPIMgmt"
                    styleClass="mgr-dash-nav-btn" text="📊  Đánh giá KPI"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="mgr-dash-logout" text="🚪  Đăng xuất"/>
        </VBox>
    </left>

    <!-- Vùng trung tâm -->
    <center>
        <VBox maxHeight="Infinity" maxWidth="Infinity" spacing="12.0" styleClass="mgr-dash-center">
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="mgr-dash-topbar">
                <Button fx:id="btnBack" onAction="#handleBack" styleClass="mgr-dash-arrow-btn" text="◀ Lùi"/>
                <Button fx:id="btnForward" onAction="#handleForward" styleClass="mgr-dash-arrow-btn" text="Tiến ▶"/>
                <Label fx:id="lblCurrentPage" text="Trung tâm Điều hành Quản lý" styleClass="mgr-dash-page-title">
                    <HBox.margin>
                        <Insets left="8.0"/>
                    </HBox.margin>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="✦ 5 Phân hệ Quản trị • Gemini AI" styleClass="mgr-dash-chip"/>
            </HBox>

            <VBox fx:id="contentContainer" alignment="TOP_LEFT" maxWidth="Infinity" spacing="18.0" VBox.vgrow="ALWAYS">
                <ScrollPane fx:id="overviewScroll" fitToWidth="true" styleClass="mgr-dash-scroll" VBox.vgrow="ALWAYS">
                    <StackPane maxWidth="Infinity">
                        <!-- Ảnh nền trang trí mờ phía sau -->
                        <ImageView fitHeight="700.0" fitWidth="1060.0" opacity="0.06" preserveRatio="false">
                            <image>
                                <Image backgroundLoading="true"
                                       url="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&amp;fit=crop&amp;w=1200&amp;q=80"/>
                            </image>
                        </ImageView>

                        <VBox fx:id="overviewView" alignment="TOP_LEFT" maxWidth="Infinity" spacing="18.0">
                            <padding>
                                <Insets bottom="24.0" left="22.0" right="22.0" top="6.0"/>
                            </padding>

                            <!-- Hero Banner -->
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="22.0" styleClass="mgr-dash-hero">
                                <ImageView fitHeight="122.0" fitWidth="185.0" preserveRatio="true"
                                           style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.4), 12, 0, 0, 4);">
                                    <image>
                                        <Image backgroundLoading="true"
                                               url="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&amp;fit=crop&amp;w=600&amp;q=80"/>
                                    </image>
                                </ImageView>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label text="✦ TRUNG TÂM ĐIỀU HÀNH NHÂN SỰ AI HRM" styleClass="mgr-dash-hero-tag"/>
                                    <Label text="Quản lý toàn diện tuyển dụng, Face ID, nhân sự, công việc &amp; KPI"
                                           styleClass="mgr-dash-hero-title" wrapText="true"/>
                                    <Label text="Chọn nhanh một phân hệ bên dưới hoặc dùng thanh menu bên trái để thao tác. Hỗ trợ Lùi / Tiến và tự động tắt camera khi chuyển màn hình."
                                           styleClass="mgr-dash-hero-sub" wrapText="true"/>
                                </VBox>
                            </HBox>

                            <!-- Hàng 1: 3 thẻ phân hệ -->
                            <HBox maxWidth="Infinity" spacing="16.0">
                                <!-- 1. Chấm công Face ID -->
                                <VBox maxWidth="Infinity" spacing="10.0" styleClass="mgr-dash-card-cyan" HBox.hgrow="ALWAYS">
                                    <Region maxWidth="Infinity" prefHeight="5.0" styleClass="mgr-dash-bar-cyan"/>
                                    <ImageView fitHeight="125.0" fitWidth="290.0" preserveRatio="true">
                                        <image>
                                            <Image backgroundLoading="true"
                                                   url="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&amp;fit=crop&amp;w=600&amp;q=80"/>
                                        </image>
                                    </ImageView>
                                    <Label text="📷 Chấm công Face ID" styleClass="mgr-dash-card-title-cyan"/>
                                    <Label text="Quét khuôn mặt trên máy quản lý, đăng ký Face ID mẫu và check-in/check-out cho nhân viên."
                                           styleClass="mgr-dash-card-desc" wrapText="true"/>
                                    <Button maxWidth="Infinity" onAction="#showAttendance"
                                            styleClass="mgr-dash-btn-cyan" text="Mở Chấm công Face ID →"/>
                                </VBox>

                                <!-- 2. Sàng lọc CV & Tuyển dụng -->
                                <VBox maxWidth="Infinity" spacing="10.0" styleClass="mgr-dash-card-purple" HBox.hgrow="ALWAYS">
                                    <Region maxWidth="Infinity" prefHeight="5.0" styleClass="mgr-dash-bar-purple"/>
                                    <ImageView fitHeight="125.0" fitWidth="290.0" preserveRatio="true">
                                        <image>
                                            <Image backgroundLoading="true"
                                                   url="https://images.unsplash.com/photo-1586281380349-632531db7ed4?auto=format&amp;fit=crop&amp;w=600&amp;q=80"/>
                                        </image>
                                    </ImageView>
                                    <Label text="📄 Sàng lọc CV &amp; Tuyển dụng" styleClass="mgr-dash-card-title-purple"/>
                                    <Label text="Xem điểm &amp; nhận xét AI, duyệt/từ chối ứng viên và tuyển dụng ứng viên APPROVED thành nhân viên."
                                           styleClass="mgr-dash-card-desc" wrapText="true"/>
                                    <Button maxWidth="Infinity" onAction="#showCVScreening"
                                            styleClass="mgr-dash-btn-purple" text="Mở Sàng lọc CV →"/>
                                </VBox>

                                <!-- 3. Quản lý Nhân sự -->
                                <VBox maxWidth="Infinity" spacing="10.0" styleClass="mgr-dash-card-emerald" HBox.hgrow="ALWAYS">
                                    <Region maxWidth="Infinity" prefHeight="5.0" styleClass="mgr-dash-bar-emerald"/>
                                    <ImageView fitHeight="125.0" fitWidth="290.0" preserveRatio="true">
                                        <image>
                                            <Image backgroundLoading="true"
                                                   url="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&amp;fit=crop&amp;w=600&amp;q=80"/>
                                        </image>
                                    </ImageView>
                                    <Label text="👥 Quản lý Nhân sự" styleClass="mgr-dash-card-title-emerald"/>
                                    <Label text="Quản lý danh sách nhân viên, cập nhật chức vụ, lương cơ bản, phòng ban và nhân sự theo nhóm."
                                           styleClass="mgr-dash-card-desc" wrapText="true"/>
                                    <Button maxWidth="Infinity" onAction="#showEmployeeMgmt"
                                            styleClass="mgr-dash-btn-emerald" text="Mở Quản lý Nhân sự →"/>
                                </VBox>
                            </HBox>

                            <!-- Hàng 2: 2 thẻ lớn còn lại -->
                            <HBox maxWidth="Infinity" spacing="16.0">
                                <!-- 4. Quản lý Công việc -->
                                <VBox maxWidth="Infinity" spacing="10.0" styleClass="mgr-dash-card-amber" HBox.hgrow="ALWAYS">
                                    <Region maxWidth="Infinity" prefHeight="5.0" styleClass="mgr-dash-bar-amber"/>
                                    <ImageView fitHeight="125.0" fitWidth="370.0" preserveRatio="true">
                                        <image>
                                            <Image backgroundLoading="true"
                                                   url="https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?auto=format&amp;fit=crop&amp;w=600&amp;q=80"/>
                                        </image>
                                    </ImageView>
                                    <Label text="📋 Quản lý Công việc (Task)" styleClass="mgr-dash-card-title-amber"/>
                                    <Label text="Giao nhiệm vụ mới, thiết lập deadline, xác nhận hoàn thành hoặc yêu cầu làm lại và quản lý toàn bộ task."
                                           styleClass="mgr-dash-card-desc" wrapText="true"/>
                                    <Button maxWidth="Infinity" onAction="#showTaskMgmt"
                                            styleClass="mgr-dash-btn-amber" text="Mở Quản lý Công việc →"/>
                                </VBox>

                                <!-- 5. Đánh giá KPI -->
                                <VBox maxWidth="Infinity" spacing="10.0" styleClass="mgr-dash-card-rose" HBox.hgrow="ALWAYS">
                                    <Region maxWidth="Infinity" prefHeight="5.0" styleClass="mgr-dash-bar-rose"/>
                                    <ImageView fitHeight="125.0" fitWidth="370.0" preserveRatio="true">
                                        <image>
                                            <Image backgroundLoading="true"
                                                   url="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&amp;fit=crop&amp;w=600&amp;q=80"/>
                                        </image>
                                    </ImageView>
                                    <Label text="📊 Đánh giá KPI &amp; Thưởng AI" styleClass="mgr-dash-card-title-rose"/>
                                    <Label text="Tổng hợp tiến độ công việc, ngày làm, phút đi muộn theo tháng để Gemini AI đánh giá KPI và đề xuất thưởng."
                                           styleClass="mgr-dash-card-desc" wrapText="true"/>
                                    <Button maxWidth="Infinity" onAction="#showKPIMgmt"
                                            styleClass="mgr-dash-btn-rose" text="Mở Đánh giá KPI →"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </StackPane>
                </ScrollPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>